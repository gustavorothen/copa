{
  "name": "copa-madu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --port 5173",
    "test": "node --experimental-strip-types tests/tournament.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create copa-madu --update-config=false",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:remote": "node scripts/check-cloudflare.mjs && wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "db:generate": "drizzle-kit generate",
    "configure:cloudflare": "node scripts/configure-cloudflare.mjs",
    "deploy:check": "wrangler deploy --dry-run --config dist/server/wrangler.json",
    "deploy": "node scripts/check-cloudflare.mjs --built && wrangler deploy --config dist/server/wrangler.json",
    "preview": "node scripts/check-cloudflare.mjs --built && wrangler preview --config dist/server/wrangler.json"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261014.1",
    "wrangler": "4.151.0"
  }
}
