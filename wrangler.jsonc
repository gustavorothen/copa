{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "copa-madu",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "copa-madu",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "./drizzle"
    }
  ]
}
